# Opcionais. Só carregam se existirem.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# Link de checkout da formação Da Quebrada ao Digital (Hotmart, Kiwify, Mercado Pago...).
# Precisa começar com https://. Sem ele, os botões de compra levam ao WhatsApp.
CHECKOUT_URL_DA_QUEBRADA_AO_DIGITAL=

# ---------- Banco e imagens (criados pela Vercel Marketplace; use `vercel env pull`) ----------
# Neon Postgres: blog, painel e contas.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Vercel Blob: imagens de capa dos posts.
BLOB_READ_WRITE_TOKEN=

# ---------- E-mail (esqueci minha senha) ----------
# Sem estas duas, o link de nova senha aparece só no log do servidor.
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend, ex.: "De Quebrada <nao-responda@dequebrada.com>"
EMAIL_FROM=

# Domínio final do site, usado em links de e-mail, sitemap, RSS e Open Graph.
SITE_URL=https://www.dequebrada.com
